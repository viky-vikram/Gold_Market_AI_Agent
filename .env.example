# AurumIQ environment template.
#
# Copy to .env and fill in locally. NEVER commit .env or real credentials.
# Every value here is a placeholder. Production refuses to start when a required
# secret is missing or an unsafe default is detected (TRD section 25).
#
# Sources: PRD Appendix A, TRD section 25.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local                      # local | test | staging | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Host port mappings for `docker compose`. Override any of these if the default
# is already taken by another project on your machine — a conflict shows up as
# "Bind for 0.0.0.0:<port> failed: port is already allocated".
POSTGRES_HOST_PORT=5432
VALKEY_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# ---------------------------------------------------------------------------
# OpenAI — runtime model is gpt-5.4-mini via the Responses API.
# No automatic escalation to a larger model is permitted (PRD section 11.1).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
OPENAI_PROJECT_ID=proj_replace_me

OPENAI_MODEL_ROUTER=gpt-5.4-mini
OPENAI_MODEL_EXTRACTOR=gpt-5.4-mini
OPENAI_MODEL_SYNTHESIS=gpt-5.4-mini
OPENAI_MODEL_VALIDATOR=gpt-5.4-mini

OPENAI_REASONING_ROUTER=low
OPENAI_REASONING_EXTRACTOR=low
OPENAI_REASONING_SYNTHESIS=medium
OPENAI_REASONING_VALIDATOR=medium

OPENAI_MAX_OUTPUT_ROUTER=800
OPENAI_MAX_OUTPUT_SYNTHESIS=4000
OPENAI_MAX_OUTPUT_VALIDATOR=2000

OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1

# Budget circuit breakers. Exceeding these suspends new AI generation while
# keeping deterministic market facts available (PRD section 14).
OPENAI_DAILY_BUDGET_INR=300
OPENAI_MONTHLY_BUDGET_INR=8000

# ---------------------------------------------------------------------------
# Database — Supabase PostgreSQL with pgvector
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://aurumiq:aurumiq@localhost:5432/aurumiq
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_ANON_KEY=replace-me
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# ---------------------------------------------------------------------------
# Valkey — cache, rate limits, locks, Celery broker
# ---------------------------------------------------------------------------
VALKEY_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=aurumiq-local
LANGSMITH_TRACING=false

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aurumiq-api
GRAFANA_CLOUD_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Quotas — see PRD section 14. Quota dates and resets are IST (Asia/Kolkata).
# ---------------------------------------------------------------------------
QUOTA_DETAILED_ANALYSES_PER_DAY=5
QUOTA_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Email delivery — provider not yet selected (PRD section 19, open decision 7)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=unset
EMAIL_FROM_ADDRESS=noreply@example.invalid
EMAIL_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Market data providers — vendors not yet legally approved
# (PRD section 19, open decisions 1-6). Sprint 3 uses a synthetic fixture
# provider only; real adapters land after a legal register entry exists.
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=fixture
NEWS_PROVIDER=fixture
